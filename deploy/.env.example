# RakkoTasks 生产环境配置模板。
# 用法：复制到仓库根并填写 → cp deploy/.env.example .env
# 全部配置项与 backend/app/config.py 的默认值一致；密钥类留空占位。
# 本文件会被 docker compose 以 env_file 形式注入 web / worker 容器。

# ── 数据与同步 ────────────────────────────────────────────────
# SQLite 数据库路径（容器内）。必须位于 /data 卷内（compose 已挂载 ../data:/data），
# 否则数据不持久化。
DATABASE_PATH=/data/rakkotasks.db
# 同步轮询间隔（分钟），worker 每轮对所有账户增量拉取一次
SYNC_INTERVAL_MINUTES=15
# 首次接入时的回补天数
INITIAL_BACKFILL_DAYS=180
# AI 搜索附带的邮件索引窗口（天）
SEARCH_INDEX_DAYS=90

# ── LLM（OpenAI-compatible，DeepSeek）────────────────────────
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek 开放平台（platform.deepseek.com）创建的 API Key
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# DeepSeek V4 系列推理档位：low/high；留空则不发送该参数（兼容不支持它的
# 模型或其它 OpenAI 兼容供应商），档位越高越贵
LLM_REASONING_EFFORT=high

# ── Phainon 鉴权 ─────────────────────────────────────────────
# Phainon 服务端地址（introspect 端点用）
PHAINON_API_BASE=https://api.rakko.cn
# Phainon 管理端注册的应用 ID，需与注册时一致
PHAINON_APP_ID=rakkotasks
# 前端来源，用于 CORS 与 introspect 的 Origin 头；须与 Phainon 应用
# allowed_origins 一致
FRONTEND_ORIGIN=https://tasks.rakko.cn

# ── Microsoft OAuth ───────────────────────────────────────────
# 微软 OAuth 默认 client_id：Thunderbird 公共客户端（第三方应用，可用于 IMAP）。
# 勿用 Microsoft Office 的 d3590ed6-52b3-4102-aeff-aad2292ab01c（第一方应用，
# 访问 Exchange Online 需预授权，会报 AADSTS65002）。
# 如个别账户需用自己的应用注册，用 accounts add --client-id 覆盖
MS_DEFAULT_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753

# ── 前端静态目录 ──────────────────────────────────────────────
# 注意：FRONTEND_DIST 已由 Dockerfile 内置为 /app/frontend-dist，
# 不要在本文件里配置（覆盖为空字符串会导致前端 404）。

# ── Cloudflare Tunnel ─────────────────────────────────────────
# Zero Trust 面板创建隧道后生成的 token（cf tunnel token create 或面板复制）。
# 注意：compose 解析 ${TUNNEL_TOKEN} 时从 shell 环境变量或 deploy/.env 读取，
# 若只在仓库根 .env 填写，请先 export（见 deploy/README.md 第 5 节）。
TUNNEL_TOKEN=
